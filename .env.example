# 复制为 .env 后填入密钥。密钥只从环境变量读取，不要写进代码。
# 优先使用 LLM_*。只配了 DEEPSEEK_* 时也会被读到。

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# auto：地址或模型名里含 deepseek 时打开思考模式，换成别的厂商则不附带这些参数。
# 也可显式设为 enabled 或 disabled。
LLM_THINKING=auto
LLM_REASONING_EFFORT=high

# 思考模式关闭时才会使用温度。
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=16384
LLM_TIMEOUT=180
